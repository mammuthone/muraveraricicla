default_platform(:ios)

# La chiave API sta in ~/.appstoreconnect/private_keys/AuthKey_<KeyID>.p8,
# la posizione standard cercata anche da altri strumenti Apple. Nel repo non
# finiscono né la chiave né gli identificativi.
KEY_ID = ENV.fetch("ASC_KEY_ID", "572AYM26U5")
IPA = "../build/ios/ipa/muraveraricicla.ipa"

def asc_api_key
  app_store_connect_api_key(
    key_id: KEY_ID,
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(
      "~/.appstoreconnect/private_keys/AuthKey_#{KEY_ID}.p8",
    ),
    in_house: false,
  )
end

platform :ios do
  desc "Compila l'IPA di release"
  lane :build do
    Dir.chdir("..") { sh("flutter", "build", "ipa", "--release") }
    UI.success("IPA pronto in build/ios/ipa/")
  end

  desc "Compila e carica su TestFlight"
  lane :beta do
    build
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: IPA,
      skip_waiting_for_build_processing: true,
    )
    UI.success("Caricata su TestFlight.")
  end

  desc "Carica solo la scheda: testi e screenshot"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_app_version_update: true,
      force: true,
    )
    UI.success("Scheda aggiornata.")
  end
end
